# Copy this file to .env and fill in the values. Never commit .env.

# --- Required -------------------------------------------------------------
# Postgres with the pgvector extension (e.g. a Neon connection string).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# OpenAI key for chat answers and embeddings.
OPENAI_API_KEY=sk-...
# Secret code needed to create an admin account at /register.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REGISTRATION_KEY=
# Bearer token the scheduled scrape (/api/cron/scrape) must send. Generate as above.
CRON_SECRET=

# --- Optional: email (password reset, support-ticket alerts) ---------------
# Without RESEND_API_KEY, emails are skipped and password reset won't work.
RESEND_API_KEY=
SUPPORT_EMAIL_FROM=BYU-Hawaii Assistant <onboarding@resend.dev>
SUPPORT_TICKET_NOTIFY_EMAIL=
# Public URL used in password-reset links (defaults to the request's origin).
APP_URL=

# --- Optional: usage limits (see docs/usage-limits.md) ---------------------
USAGE_LIMIT_PER_SESSION_DAILY=
USAGE_LIMIT_GLOBAL_DAILY_USERS=
USAGE_LIMIT_GLOBAL_WEEKLY_USERS=
USAGE_LIMIT_MESSAGE_GLOBAL=
USAGE_LIMIT_MESSAGE_SESSION=

# --- Optional: cookies -----------------------------------------------------
# Force secure cookies on/off ("true"/"false"); auto-detected when unset.
COOKIE_SECURE=
